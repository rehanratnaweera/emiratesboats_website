# Copy to .env and fill in. .env is not committed.

# Gemini API key from https://aistudio.google.com/apikey, used by `pnpm translate`.
GEMINI_API_KEY=

# Optional: the models that translate, in order of preference, comma-separated.
# GEMINI_MODELS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash
